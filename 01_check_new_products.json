    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gpt-4o-mini',\n  response_format: { type: 'json_object' },\n  messages: [\n    {\n      role: 'system',\n      content: 'You translate product texts for a German online furniture shop. Translate from English into natural, customer-friendly German. Keep all numbers, measurements and units exactly as given; only translate words (for example W/D/H becomes B/T/H). Keep line breaks. Do not add or invent information. Answer only with a JSON object with the keys description_de, dimensions_de, material_construction_de and features_feel_de. If an input text is empty, return an empty string for it.'\n    },\n    {\n      role: 'user',\n      content: JSON.stringify({\n        description: $('Keep only new products').item.json.description_en,\n        dimensions: $('Keep only new products').item.json.dimensions_en,\n        material_construction: $('Keep only new products').item.json.material_construction_en,\n        features_feel: $('Keep only new products').item.json.features_feel_en\n      })\n    }\n  ]\n}) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1
            }
          },
          "timeout": 60000
        }
      },
      "id": "8edaff63-70d6-467e-9c23-7dea028e93bf",
      "name": "Translate with OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1632,
        -624
      ],
      "credentials": {
        "openAiApi": {
          "id": "b0may8WsgVgEAfvI",
          "name": "OpenAI account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Read the JSON answer from OpenAI and build the sheet update for this product.\nconst row = $('Keep only new products').item.json;\nconst now = new Date().toISOString();\n\ntry {\n  const t = JSON.parse($json.choices[0].message.content);\n  return {\n    json: {\n      id: row.id,                      // used to find the right row in the sheet\n      description_de: t.description_de || '',\n      dimensions_de: t.dimensions_de || '',\n      material_construction_de: t.material_construction_de || '',\n      features_feel_de: t.features_feel_de || '',\n      status: 'Wartet auf Freigabe',\n      error: '',\n      updated_at: now,\n    },\n  };\n} catch (e) {\n  // OpenAI answered, but not with the JSON we expected\n  return {\n    json: { id: row.id, status: 'Fehler', error: 'Translation could not be read: ' + e.message, updated_at: now },\n  };\n}"
      },
      "id": "2d25c01a-1d9b-4e35-beda-7817097d043d",
      "name": "Prepare translated row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1904,
        -704
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The OpenAI request failed (no credit, wrong key, timeout, ...).\n// Mark the product as \"Fehler\" and keep the reason in the error column.\nconst row = $('Keep only new products').item.json;\nconst err = $json.error;\nconst message = typeof err === 'string' ? err : (err && err.message) || JSON.stringify($json);\n\nreturn {\n  json: {\n    id: row.id,\n    status: 'Fehler',\n    error: ('Translation failed: ' + message).slice(0, 500),\n    updated_at: new Date().toISOString(),\n  },\n};"
      },
      "id": "9fc3daeb-3abc-46a0-a7be-4244dc89fca5",
      "name": "Prepare error row",
