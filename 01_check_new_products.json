    {
      "parameters": {
        "jsCode": "// Compare the scraped products with the rows already in the sheet.\n// The product URL is the unique key: a product whose URL is already in the\n// sheet is skipped, so running the workflow twice never creates duplicates.\n\nconst scraped = $('Scrape products').first().json;\nconst existingUrls = new Set(\n  $('Read existing rows').all()\n    .map(item => String(item.json.url || '').trim())\n    .filter(url => url !== '')\n);\n\nconst now = new Date().toISOString();\nconst newRows = [];\n\nfor (const p of scraped.products || []) {\n  if (existingUrls.has(p.url)) continue;   // already in the sheet -> skip\n  newRows.push({\n    json: {\n      id: p.id,\n      title: p.title,\n      product_type: p.product_type,\n      price: p.price,\n      url: p.url,\n      image_urls: (p.images || []).map(img => img.src).join('\\n'),\n      description_en: p.description_en,\n      dimensions_en: p.dimensions,\n      material_construction_en: p.material_construction,\n      features_feel_en: p.features_feel,\n      description_de: '',\n      dimensions_de: '',\n      material_construction_de: '',\n      features_feel_de: '',\n      status: 'Neu',\n      approval: '',\n      error: '',\n      created_at: now,\n      updated_at: now,\n    },\n  });\n}\n\n// Returning an empty list stops the workflow here: nothing new to do.\nreturn newRows;"
      },
